# Automatic HTTPS. Caddy obtains and renews a Let's Encrypt certificate for
# $DOMAIN on its own, which is the whole reason it is here: Telegram will not
# call a webhook that is plain HTTP or self-signed, and the Mini App will not
# load over anything but valid TLS.
#
# DOMAIN and ACME_EMAIL come from the .env beside docker-compose.yml.
#
# NOTE: the certificate is obtained over an HTTP-01 challenge on port 80, which
# means Let's Encrypt must reach THIS server. Behind Cloudflare's orange cloud
# it reaches Cloudflare instead and the challenge fails. Set the DNS records to
# "DNS only" until the certificate is issued, then re-enable the proxy with
# SSL/TLS mode "Full (strict)".
{
	email {$ACME_EMAIL}
}

# www redirects to the apex rather than serving a second copy. One canonical
# origin matters here beyond tidiness: Telegram pins the Mini App and the
# webhook to an exact host, and a session started on one hostname does not
# carry to the other.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode gzip

	# Everything goes to the frontend nginx, which owns the routing split
	# between the SPA bundle and the proxied /api, /hooks, /admin, /static.
	# Keeping that split in one place means the Mini App, the web app and the
	# webhooks stay on a single origin — which Telegram requires.
	reverse_proxy frontend:80 {
		header_up X-Forwarded-Proto {scheme}
	}
}
