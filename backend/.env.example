# --- Django ---
# WARNING: a literal $ in any value here is eaten by Docker Compose.
# `env_file:` runs variable interpolation, so DJANGO_SECRET_KEY=abc$hu123
# reaches the container as abc123 — silently a different key than this file
# shows. Generate secrets with token_urlsafe (letters, digits, _ and - only):
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# or escape each dollar as $$.
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# --- Data stores ---
# Left unset locally so the scaffold runs on SQLite with no Postgres install.
# Under docker compose this is IGNORED: compose supplies its own, built from the
# POSTGRES_* values in the .env beside docker-compose.yml, and resolving to
#   postgresql://predict:predict@postgres:5432/predict
# Set it here only to point local dev at a real Postgres, e.g.
#   DATABASE_URL=postgresql://predict:predict@localhost:5432/predict
REDIS_URL=redis://localhost:6379/0

# --- API-Football (https://www.api-football.com/) ---
# Direct plan uses v3.football.api-sports.io with x-apisports-key.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Only sync these league api-ids (comma-separated). Empty = all configured in DB.
API_FOOTBALL_LEAGUES=39,140,135,78,61,2,3

# --- Prediction engine ---
# Narrative layer only — poisson.py owns every probability, so this model never
# affects accuracy, only cost and voice.
OPENAI_API_KEY=
# gpt-5.6-terra $2/$12 per MTok (default) | gpt-5.6-sol $4/$20 | gpt-5.6-luna $0.20/$1.20
PREDICTION_MODEL=gpt-5.6-terra
# Buy the daily slate's prose through the batch endpoint at half price. Results
# land after publishing, so picks ship without a read and it is backfilled.
# Set False to write prose inline during generation (full price, immediate).
LLM_BATCH_ENABLED=True
LLM_BATCH_COMPLETION_WINDOW=24h
# Predictions below this confidence are never published.
MIN_PUBLISH_CONFIDENCE=55

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Set in prod to run via webhook instead of long-polling.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Telegram ids allowed to approve payments (comma-separated). Without at
# least one, submitted payments queue up with nobody notified. Get yours
# by messaging @userinfobot.
TELEGRAM_ADMIN_IDS=

# --- Billing: crypto rail ---
# NOWPayments (https://nowpayments.io/) — primary. Cryptomus is the fallback rail.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# --- Free tier ---
FREE_CREDITS_ON_SIGNUP=10
REFERRAL_BONUS_CREDITS=5
