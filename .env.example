# Compose-level settings. This file sits beside docker-compose.yml and is NOT
# the application env — that one is backend/.env.
#
#   cp .env.example .env   and fill in all four.

# Caddy requests a Let's Encrypt certificate for this name. DNS must already
# point at this server before the first `docker compose up`.
DOMAIN=predict.example.com
ACME_EMAIL=you@example.com

# Postgres credentials for the in-cluster database. Compose builds DATABASE_URL
# from these three plus the service name:
#   postgresql://<user>:<password>@postgres:5432/<db>
# Nothing outside the compose network can reach it, but the password still ends
# up in `docker compose config` output — make it long and don't reuse it.
POSTGRES_DB=predict
POSTGRES_USER=predict
POSTGRES_PASSWORD=change-me-to-something-long

# Process counts. Each gunicorn worker and each celery process loads numpy and
# scipy, so budget 150-250 MB apiece. Defaults are 3 and 2; on a 1-2 GB host
# use 2 and 1, and make sure the box has swap.
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=2
